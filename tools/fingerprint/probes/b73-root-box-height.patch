diff --git a/src/browser/tests/frames/root_box_heights.html b/src/browser/tests/frames/root_box_heights.html
new file mode 100644
index 000000000..67f985610
--- /dev/null
+++ b/src/browser/tests/frames/root_box_heights.html
@@ -0,0 +1,143 @@
+<!DOCTYPE html>
+<body>
+<script src="../testing.js"></script>
+
+<!--
+The HEIGHT half of root_box_edges.html, which asserts only widths and says so.
+
+An `auto` height on the two root containers is sized by their CONTENT in
+standards mode and FILLS the viewport in quirks mode. This engine filled the
+viewport for both, so every document it served answered the same height off its
+<body> whatever the document held -- `getComputedStyle(body).height` was
+`184px` for an empty body, for a body holding a 20px div and for a body holding
+a 900px one alike, in a 200px frame. That reading travels: the Cloudflare widget
+dumps a whole computed style off the <body>, and on example.com Chrome answers
+`98.0781px` there where this engine answered `756px`
+(scratch/b72/expr-body-height.js).
+
+Every number below is measured on a headed Chrome 151 at devicePixelRatio 2
+against these exact support documents (scratch/b73/expr-height-row.js over
+scratch/b73/ch-support-row.json), each in a 400x200 borderless iframe. The rules
+the table encodes:
+
+  * STANDARDS, <body>: the height is what it holds, and its children's margins
+    ESCAPE it -- `child_margin` holds a 20px div with 30px margins and the body
+    is 20 tall, not 80. clientHeight/scrollHeight add its padding, offsetHeight
+    adds its border, and the computed `height` is the content box.
+  * STANDARDS, <html>: the height is the <body>'s MARGIN box, plus its own
+    padding and border for offsetHeight -- `border` is 36px of computed height
+    and 50 of offsetHeight. An empty body is 8 and not 16, because a
+    self-collapsing box's own two margins collapse into one.
+  * STANDARDS, clientHeight/scrollHeight on <html>: the root is the scrolling
+    element, so clientHeight is the VIEWPORT (200 throughout, the mirror of the
+    width rule in root_box_edges.html) and scrollHeight is the scrolling AREA --
+    `max(viewport, the root's border box)`, which is 200 for every short
+    document here and 430 for `tall`.
+  * QUIRKS: the <body> fills instead, and the swap in `cssomViewport` puts the
+    viewport on ITS clientHeight and the root's own box on the root's. A quirks
+    body still GROWS past the fill when it holds more (`quirks_overflow` is 900
+    of offsetHeight, not 184), and both containers grow with it.
+
+Two readings are deliberately NOT asserted, and they are measured so the next
+hop does not have to: `<html style="height:100%"><body style="height:100%">` is
+body 200/200/200/200px and root 200/200/208/200px -- the 208 is the body's
+margin box hanging 8px past a root that is exactly the viewport, which needs a
+scrolling area built from the descendants' bounds rather than from the root's
+own border box. And `body{min-height:100vh}` is body 200/200/200/200px, root
+200/216/216/216px. Both are percentage/viewport-relative heights, a different
+question from the `auto` one this file is about.
+-->
+
+<iframe id=empty src="support/root_box_empty.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=plain src="support/root_box_plain.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=nested src="support/root_box_nested.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=child_margin src="support/root_box_child_margin.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=body_margin0 src="support/root_box_body_margin0.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=body_margin src="support/root_box_body_margin.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=body_edges src="support/root_box_body_edges.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=decl_height src="support/root_box_decl_height.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=root_height src="support/root_box_root_height.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=border src="support/root_box_border.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=padding src="support/root_box_padding.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=margin src="support/root_box_margin.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=width src="support/root_box_width.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=tall src="support/root_box_tall.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=overflow src="support/root_box_overflow.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=quirks_plain src="support/root_box_quirks_plain.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=quirks_overflow src="support/root_box_quirks_overflow.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=quirks_border src="support/root_box_quirks_border.html" style="width:400px;height:200px;border:0"></iframe>
+<iframe id=quirks_padding src="support/root_box_quirks_padding.html" style="width:400px;height:200px;border:0"></iframe>
+
+<script id=root_container_heights_are_the_content>
+testing.onload(() => {
+  // The whole row is one string with the document's id in front, so a failure
+  // names the document and the reading that moved without a separate message.
+  const read = (id) => {
+    const d = document.getElementById(id).contentDocument;
+    const r = d.documentElement, b = d.body;
+    const box = (el) => [
+      el.clientHeight, el.offsetHeight, el.scrollHeight,
+      d.defaultView.getComputedStyle(el).height,
+    ].join('/');
+    return [id, d.compatMode, 'body', box(b), 'root', box(r)].join(' ');
+  };
+
+  // The grid is 1/64 of a DEVICE pixel, so the table only means anything at the
+  // ratio it was measured at.
+  testing.expectEqual(2, window.devicePixelRatio);
+
+  // Every row is compared and only the ones that disagree are reported. An
+  // assertion per row would stop at the first, and a nineteen-row diff is what
+  // says whether a change moved one document or all of them.
+  const chrome151 = [
+    'empty CSS1Compat body 0/0/0/0px root 200/8/200/8px',
+    'plain CSS1Compat body 20/20/20/20px root 200/36/200/36px',
+    'nested CSS1Compat body 20/20/20/20px root 200/36/200/36px',
+    'child_margin CSS1Compat body 20/20/20/20px root 200/80/200/80px',
+    'body_margin0 CSS1Compat body 20/20/20/20px root 200/20/200/20px',
+    'body_margin CSS1Compat body 20/20/20/20px root 200/60/200/60px',
+    'body_edges CSS1Compat body 32/40/32/20px root 200/56/200/56px',
+    'decl_height CSS1Compat body 50/50/50/50px root 200/66/200/66px',
+    'root_height CSS1Compat body 20/20/20/20px root 200/150/200/150px',
+    'border CSS1Compat body 20/20/20/20px root 200/50/200/36px',
+    'padding CSS1Compat body 20/20/20/20px root 200/60/200/36px',
+    'margin CSS1Compat body 20/20/20/20px root 200/50/200/36px',
+    'width CSS1Compat body 20/20/20/20px root 200/50/200/36px',
+    'tall CSS1Compat body 400/400/400/400px root 200/430/430/416px',
+    'overflow CSS1Compat body 900/900/900/900px root 200/916/916/916px',
+    'quirks_plain BackCompat body 200/184/200/184px root 200/200/200/200px',
+    'quirks_overflow BackCompat body 200/900/916/900px root 916/916/916/916px',
+    'quirks_border BackCompat body 200/170/200/170px root 186/200/186/186px',
+    'quirks_padding BackCompat body 200/160/200/160px root 186/200/186/176px',
+  ];
+
+  // One row this engine knowingly answers differently, kept here as the number
+  // it does answer so the Chrome row above stays readable beside it.
+  //
+  // `child_margin` holds a 20px div wearing a 30px margin. The div's margins
+  // ESCAPE the body -- both arms agree the body is 20 tall -- and in Chrome they
+  // then collapse with the body's own 8px and land in the ROOT's content height,
+  // making it 80. Here they simply vanish once they leave the child, so the root
+  // is 36: the body's box plus the body's own two margins.
+  //
+  // That is a margin-collapse defect and not a root-container one: measured on
+  // both arms with scratch/b73/expr-escaped-margin.js, a plain div holding a
+  // wrapper holding the same margined div is 20 on both, at one, two and three
+  // levels of nesting -- but a body holding four such wrappers is 220 in Chrome
+  // and 130 here, which is exactly the three 30px inter-sibling gaps the
+  // escaped margins should have collapsed into.
+  const residual = {
+    child_margin: 'child_margin CSS1Compat body 20/20/20/20px root 200/36/200/36px',
+  };
+
+  const off = [];
+  for (const chrome of chrome151) {
+    const id = chrome.split(' ')[0];
+    const expected = residual[id] ?? chrome;
+    const actual = read(id);
+    if (actual !== expected) off.push(`want[${expected}] got[${actual}]`);
+  }
+  testing.expectEqual('', off.join('\n'));
+});
+</script>
+</body>
