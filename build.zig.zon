        },
        // Carried in-tree rather than fetched: the ClientHello has to offer
        // Chrome's ML-DSA signature algorithms, and the revision the upstream
        // wrapper pins predates those code points. deps/boringssl-zig/README.md
        // says what differs from the wrapper and how to re-sync it.
        .@"boringssl-zig" = .{ .path = "deps/boringssl-zig" },
        .curl = .{
            // Pinned to 8.20: deps/curl-patched/lib/{http,http2}.c are this
            // fork's patched copies of that release's files (Chrome's h2 cookie
            // splitting and header order), and they do not apply to 8.22.
            // Bumping curl means re-patching them, which is its own plan.
            .url = "https://github.com/curl/curl/releases/download/curl-8_20_0/curl-8.20.0.tar.gz",
            .hash = "N-V-__8AAHM9RQHjzJo8Wn4dbGPqNOC21zZJJA9PcCj7FPF5",
        },
        .sqlite3 = .{
            .url = "https://github.com/allyourcodebase/sqlite3/archive/7a615f5af79009cd733e3480658586d9b0d28b35.tar.gz",
            .hash = "sqlite3-3.53.2-DMxLWuAOAAA_Px0arJOIOaP4AKEu5prbsQgPMA35W1zz",
        },
        .zenai = .{
            .url = "git+https://github.com/lightpanda-io/zenai.git#be5d2e70d3dcc9866041dbdbcfa1f18799601a30",
            .hash = "zenai-0.0.0-iOY_VE23BgCNT-WtrAC6BM1J_G98bSk6kD0v8g09XWYA",
        },
        .isocline = .{
